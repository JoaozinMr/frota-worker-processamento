{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "frota-worker-processamento",
    "Topic": "frota.telemetria",
    "DlqTopic": "frota.telemetria.dlq",
    "MaxProcessingAttempts": 3,
    "CommitEveryMessages": 100
  },
  "Rules": {
    "SpeedLimitKmh": 80,
    "GeofenceCenterLatitude": -23.5505,
    "GeofenceCenterLongitude": -46.6333,
    "GeofenceRadiusMeters": 50000,
    "DeduplicationMinutes": 5,
    "DeadSensorThresholdSeconds": 60,
    "DeadSensorCheckIntervalSeconds": 15
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=frota;Username=frota;Password=frota",
    "BatchSize": 500,
    "FlushIntervalMs": 2000
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Alertas": {
    "BaseUrl": "http://localhost:5100",
    "Path": "/api/alerts",
    "TimeoutSeconds": 3,
    "RetryCount": 3
  },
  "AllowedHosts": "*"
}
